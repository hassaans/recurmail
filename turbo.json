{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "SENDER_CRON_SECRET",
    "RESEND_API_KEY",
    "RECONNECT_EMAIL_FROM",
    "ADMIN_EMAILS",
    "SENTRY_CRON_MONITOR_SLUG",
    "SENTRY_DSN"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    }
  }
}
